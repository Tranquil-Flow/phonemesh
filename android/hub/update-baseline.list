# The signed baseline catalog of the packs every Phonemesh build knows (GeneratedPackCatalog). The owner makes it, together with
# public-keys.txt, in one step (docs/update-keys.md):
#   phonemesh-hub sign-baseline --public-keys public-keys.txt --key catalog-key.pem --list hub/update-baseline.list \
#     --packs model-packs --out core/src/main/resources/update
# Paths in this list are relative to the --packs folder. Until the owner's real keys arrive the shipped baseline is signed by the
# TEST catalog key (core/src/main/resources/update/public-keys.txt), and a release build refuses those keys (updates are off in it).
epoch = 1
sequence = 1
issued-at = 1793145600
min-reader = 1
pack file=phonemesh-engine-whisper-tiny-1.zip
pack file=phonemesh-engine-whisper-base-1.zip
pack file=phonemesh-voice-en-US-ljspeech-1.zip
pack file=phonemesh-voice-fr-siwis-1.zip
