<?xml version="1.0" encoding="utf-8"?>
<!-- The demo build only: a separate app ("Phonemesh Demo") with simulated radio, people and hub. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:name="org.phonemesh.app.demo.DemoApp" android:label="@string/demo_app_name"
        tools:replace="android:label">
        <activity android:name="org.phonemesh.app.demo.DemoControlsActivity" android:exported="true"
            android:label="@string/demo_controls_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
